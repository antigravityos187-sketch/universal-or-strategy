{
	"folders": [
		{
			"name": "Wave -- C# Source (main)",
			"path": "."
		},
		{
			"name": "Director -- Docs/Spec/Brain (PTT)",
			"path": "../universal-or-strategy-director"
		}
	],
	"settings": {
		"[csharp]": {
			"editor.defaultFormatter": "csharpier.csharpier-vscode",
			"editor.formatOnSave": true
		},
		"files.associations": {
			"*.cs": "csharp"
		},
		"files.watcherExclude": {
			"**/.git/objects/**": true,
			"**/.git/subtree-cache/**": true,
			"**/node_modules/*/**": true,
			"**/.hg/store/**": true,
			"**/bin/**": true,
			"**/obj/**": true
		},
		"omnisharp.workspaceModels": true,
		"omnisharp.enableEditorConfigSupport": true,
		"omnisharp.enableRoslynAnalyzers": true,
		"omnisharp.projectSystem.includeProjectsNotInSolution": true,
		"omnisharp.projectFilesExcludePattern": [
			"**/archive/**",
			"**/obj/**",
			"**/bin/**"
		],
		"dotnet.defaultSolution": "src/PropTraderTools/PropTraderTools.csproj"
	}
}
