<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Verify.Xunit" Version="26.6.0" />
  </ItemGroup>

  <!--
    NOTE: V12_002 is a NinjaTrader 8 strategy that can ONLY be compiled within the NT8 environment.
    It depends on NT8 proprietary assemblies (NinjaTrader.Cbi, NinjaTrader.Gui, etc.) which are
    not available in standalone .NET builds.
    
    ARCHITECTURAL CONSTRAINT: NinjaTrader strategies compile at runtime within NT8, not as standalone projects.
    
    TESTING STRATEGY:
    - Unit tests in this project test extracted helper methods that DON'T depend on NT8 assemblies
    - Integration tests requiring V12_002 strategy code must run via NT8 Strategy Analyzer
    - Complexity audits use CodeScene/Codacy (not local dotnet tools)
    
    EPIC-CCN-12: Originally attempted to reference V12_002.csproj, but this is architecturally impossible.
    Jane Street Alignment: Tests are part of same codebase (not separate enforcement gate).
  -->
</Project>

