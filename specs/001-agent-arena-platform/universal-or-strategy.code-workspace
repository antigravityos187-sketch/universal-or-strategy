{
	"folders": [
		{
			"name": "universal-or-strategy",
			"path": "../.."
		}
	],
	"settings": {
		"[csharp]": {
			"editor.defaultFormatter": "csharpier.csharpier-vscode",
			"editor.formatOnSave": true
		},
		"files.associations": {
			"*.cs": "csharp"
		},
		"files.watcherExclude": {
			"**/.git/objects/**": true,
			"**/.git/subtree-cache/**": true,
			"**/node_modules/*/**": true,
			"**/.hg/store/**": true,
			"**/bin/**": true,
			"**/obj/**": true
		}
	}
}